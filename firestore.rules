rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador: o bien el correo de Google verificado, o bien una cuenta de la lista /admins.
    // La lista /admins se llena solo desde la consola de Firebase (ningún cliente puede escribirla),
    // así no hay teléfonos, contraseñas ni identificadores de cuenta dentro del repositorio.
    function esAdmin() {
      return request.auth != null && (
        (request.auth.token.email == 'breakgasper@gmail.com' && request.auth.token.email_verified == true)
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Cada administrador puede leer su propio registro (la app lo usa para saber si tiene permiso).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Pedidos: cualquier visitante puede CREAR uno válido; solo el admin lee/edita/borra.
    match /pedidos/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['nombre', 'telefono', 'direccion', 'items', 'total', 'notas', 'estado', 'creado'])
                    && request.resource.data.keys().hasAll(
                         ['nombre', 'telefono', 'direccion', 'items', 'total', 'estado', 'creado'])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
                    && request.resource.data.telefono is string
                    && request.resource.data.telefono.size() >= 7 && request.resource.data.telefono.size() <= 20
                    && request.resource.data.direccion is string
                    && request.resource.data.direccion.size() > 0 && request.resource.data.direccion.size() <= 200
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0 && request.resource.data.total <= 100000
                    && (!('notas' in request.resource.data)
                        || (request.resource.data.notas is string && request.resource.data.notas.size() <= 300))
                    && request.resource.data.estado == 'nuevo'
                    && request.resource.data.creado == request.time;
      allow read, update, delete: if esAdmin();
    }

    // Menú de la tienda (un solo documento: config/menu). Lo lee cualquiera; solo un admin lo cambia.
    match /config/{documento} {
      allow read: if true;
      allow write: if esAdmin()
                   && request.resource.data.items is list
                   && request.resource.data.items.size() <= 150;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
